# Hermes TUI — Terminal Dashboard for Hermes Agent
#
# AI_GATEWAY_MODEL — the model to use (defaults to anthropic/claude-haiku-4.5)
AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5
#
# AI_GATEWAY_API_KEY — your AI Gateway API key
AI_GATEWAY_API_KEY=
#
# HERMES_DIR — path to Hermes data directory (defaults to ~/.hermes)
HERMES_DIR=~/.hermes
